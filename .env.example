# Banco de dados (MariaDB)
DB_ROOT_PASSWORD=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# Porta exposta no host; dentro do container o banco continua em 3306
DB_EXTERNAL_PORT=

# Autenticação
# JWT_SECRET assina os tokens de sessão.
# JWT_VERIFY_SECRET assina os links de confirmação de e-mail e PRECISA ser
# diferente de JWT_SECRET: com a mesma chave, um link de confirmação vira
# um token de sessão válido.
JWT_SECRET=
JWT_VERIFY_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# SMTP
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM_NAME=
MAIL_FROM_ADDRESS=

# Aplicação
# API_PORT é a porta publicada no host; dentro do container a API escuta 3000
API_PORT=
APP_BASE_URL=
FRONTEND_URL=
NODE_ENV=
